<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cart - <%= storeName %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <nav class="navbar">
        <div class="nav-container">
            <a href="/" class="nav-logo">SOUTHSIDE <span class="red-text">RP</span></a>
            <div class="nav-links">
                <a href="/#store">Store</a>
                <a href="/#about">About</a>
                <a href="/cart">Cart (<span id="cartCount"><%= cartCount %></span>)</a>
                <a href="https://discord.gg/pwRPhNWU7T" target="_blank" class="btn btn-outline-red btn-sm">Discord</a>
            </div>
        </div>
    </nav>

    <section class="section" style="padding-top: 120px;">
        <div class="container">
            <div class="text-center mb-48">
                <span class="sec-eyebrow">Cart</span>
                <h2 class="sec-title">Your <span class="red-text">Cart</span></h2>
            </div>

            <% if (cart.length === 0) { %>
            <div class="empty-cart">
                <p>Your cart is empty</p>
                <a href="/store" class="btn btn-red btn-xl">Browse Store</a>
            </div>
            <% } else { %>
            <div class="cart-grid">
                <div class="cart-items">
                    <% cart.forEach(item => { %>
                    <div class="cart-item" data-id="<%= item.id %>">
                        <div class="cart-item-icon">📦</div>
                        <div class="cart-item-info">
                            <h3><%= item.name %></h3>
                            <p>&pound;<%= item.price.toFixed(2) %> each</p>
                        </div>
                        <div class="cart-item-qty">
                            <button onclick="updateCart(<%= item.id %>, <%= item.quantity - 1 %>)">-</button>
                            <span><%= item.quantity %></span>
                            <button onclick="updateCart(<%= item.id %>, <%= item.quantity + 1 %>)">+</button>
                        </div>
                        <div class="cart-item-total">&pound;<%= (item.price * item.quantity).toFixed(2) %></div>
                        <button class="cart-item-remove" onclick="removeFromCart(<%= item.id %>)">&#10005;</button>
                    </div>
                    <% }); %>
                </div>

                <div class="cart-summary">
                    <h2>Order Summary</h2>
                    <div class="summary-row">
                        <span>Subtotal</span>
                        <span>&pound;<%= total.toFixed(2) %></span>
                    </div>
                    <div class="summary-row total">
                        <span>Total</span>
                        <span>&pound;<%= total.toFixed(2) %></span>
                    </div>
                    <a href="/checkout" class="btn btn-red btn-xl" style="width: 100%; margin-bottom: 12px;">Proceed to Checkout</a>
                    <a href="/store" class="btn btn-outline-red btn-xl" style="width: 100%;">Continue Shopping</a>
                </div>
            </div>
            <% } %>
        </div>
    </section>

    <footer class="footer">
        <div class="container">
            <div class="footer-bottom">
                <p>&copy; 2026 <%= storeName %>. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script src="/js/store.js"></script>
</body>
</html>
