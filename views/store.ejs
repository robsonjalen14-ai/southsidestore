<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Store - <%= storeName %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <script>window.__TEBEX_STORE = '<%= tebexStore %>';</script>
    <nav class="navbar">
        <div class="nav-container">
            <a href="/" class="nav-logo">SOUTHSIDE <span class="red-text">RP</span></a>
            <div class="nav-links">
                <a href="/#store">Store</a>
                <a href="/#about">About</a>
                <a href="/cart">Cart (<span id="cartCount"><%= cartCount %></span>)</a>
                <a href="https://discord.gg/pwRPhNWU7T" target="_blank" class="btn btn-red btn-sm">Join Server</a>
                <a href="https://discord.gg/pwRPhNWU7T" target="_blank" class="btn btn-outline-red btn-sm">Discord</a>
            </div>
        </div>
    </nav>

    <section class="section" style="padding-top: 120px;">
        <div class="container">
            <div class="text-center mb-48">
                <span class="sec-eyebrow">Store</span>
                <h2 class="sec-title">Featured <span class="red-text">Packages</span></h2>
                <p class="sec-sub">Support the server and unlock exclusive perks</p>
            </div>

            <div class="category-filter">
                <a href="/store?category=all" class="filter-btn <%= category === 'all' ? 'active' : '' %>">All</a>
                <a href="/store?category=Vehicles" class="filter-btn <%= category === 'Vehicles' ? 'active' : '' %>">Vehicles</a>
                <a href="/store?category=Whitelists" class="filter-btn <%= category === 'Whitelists' ? 'active' : '' %>">Whitelists</a>
                <a href="/store?category=Clothing" class="filter-btn <%= category === 'Clothing' ? 'active' : '' %>">Clothing</a>
            </div>

            <div class="products-grid">
                <% products.forEach(product => { %>
                <div class="product-card">
                    <div class="product-icon"><%= product.icon %></div>
                    <div class="product-body">
                        <span class="product-category"><%= product.category %></span>
                        <h3 class="product-name"><%= product.name %></h3>
                        <p class="product-desc"><%= product.description %></p>
                        <div class="product-footer">
                            <span class="product-price">&pound;<%= product.price.toFixed(2) %></span>
                            <div class="product-buy">
                                <% if (product.qty) { %>
                                <select class="qty-select" id="qty-<%= product.id %>">
                                    <option value="1">1x</option>
                                    <option value="2">2x</option>
                                </select>
                                <% } %>
                                <button class="btn btn-red" onclick="addToCart(<%= product.id %>)">Buy Now</button>
                            </div>
                        </div>
                    </div>
                </div>
                <% }); %>
            </div>
        </div>
    </section>

    <section id="about" class="section section-alt">
        <div class="container">
            <div class="text-center mb-48">
                <span class="sec-eyebrow">Why Us</span>
                <h2 class="sec-title">Why <span class="red-text">Southside RP</span>?</h2>
            </div>
            <div class="usp-grid">
                <div class="usp-card">
                    <div class="usp-icon">🛡️</div>
                    <h3>Active Staff</h3>
                    <p>24/7 moderation to ensure the best roleplay experience</p>
                </div>
                <div class="usp-card">
                    <div class="usp-icon">🎮</div>
                    <h3>Custom Scripts</h3>
                    <p>Unique vehicles, jobs, and activities</p>
                </div>
                <div class="usp-card">
                    <div class="usp-icon">🌍</div>
                    <h3>Community Driven</h3>
                    <p>Built by players, for players</p>
                </div>
                <div class="usp-card">
                    <div class="usp-icon">👥</div>
                    <h3>Active Community</h3>
                    <p>100+ active members on Discord</p>
                </div>
            </div>
        </div>
    </section>

    <footer class="footer">
        <div class="container">
            <div class="footer-inner">
                <div class="footer-brand">
                    <h3>SOUTHSIDE <span class="red-text">RP</span></h3>
                    <p>Premium FiveM Roleplay Server</p>
                </div>
                <div class="footer-links">
                    <a href="/#store">Store</a>
                    <a href="/#about">About</a>
                    <a href="https://discord.gg/pwRPhNWU7T" target="_blank">Discord</a>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2026 <%= storeName %>. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script src="/js/store.js"></script>
</body>
</html>
