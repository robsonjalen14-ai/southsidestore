<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Placed - <%= storeName %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700;800;900&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <div class="success-page">
        <div class="success-content">
            <div class="success-icon">&#10003;</div>
            <h1>Order <span class="blue-text">Placed!</span></h1>
            <p>Thank you, <strong><%= ign %></strong>!</p>
            <div class="purchase-summary">
                <p><strong>Total:</strong> &pound;<%= total.toFixed(2) %></p>
                <p style="margin-top: 16px; color: var(--text-muted); font-size: 0.9rem;">Your order has been sent to our team.</p>
            </div>
            <div class="success-steps" style="background: var(--bg-2); border: 1px solid var(--blue-border); border-radius: 14px; padding: 24px; margin: 24px 0; text-align: left;">
                <h3 style="margin-bottom: 14px;">Next Steps:</h3>
                <ol style="padding-left: 20px; color: var(--text-muted); line-height: 1.8;">
                    <li>Join our Discord server</li>
                    <li>Open a ticket with your order details</li>
                    <li>Complete payment via Discord</li>
                    <li>Receive your items in-game!</li>
                </ol>
            </div>
            <div class="success-buttons">
                <a href="https://discord.gg/pwRPhNWU7T" target="_blank" class="btn btn-blue btn-xl" style="width: 100%; margin-bottom: 12px;">Join Discord</a>
                <a href="/" class="btn btn-outline-blue btn-xl" style="width: 100%;">Back to Store</a>
            </div>
        </div>
    </div>
</body>
</html>
