<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= product.name %> - <%= storeName %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700;800;900&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <script>window.__TEBEX_STORE = '<%= tebexStore %>';</script>
    <nav class="navbar" id="navbar">
        <div class="nav-container">
            <a href="/" class="nav-logo">SOUTHSIDE <span class="blue-text">RP</span></a>
            <div class="nav-links">
                <a href="/#store">Store</a>
                <a href="/#about">About</a>
                <a href="/cart">Cart (<span id="cartCount"><%= cartCount %></span>)</a>
                <a href="https://discord.gg/pwRPhNWU7T" target="_blank" class="btn btn-outline-blue btn-sm">Discord</a>
            </div>
        </div>
    </nav>

    <section class="section" style="padding-top: 120px;">
        <div class="container">
            <div class="detail-grid">
                <div class="detail-image"><%= product.icon %></div>
                <div class="detail-info">
                    <span class="product-category"><%= product.category %></span>
                    <h1><%= product.name %></h1>
                    <p class="detail-desc"><%= product.description %></p>
                    <div class="detail-price">&pound;<%= product.price.toFixed(2) %></div>
                    <div class="detail-features">
                        <h3>What's Included:</h3>
                        <ul>
                            <% product.features.forEach(feature => { %>
                            <li>&#10003; <%= feature %></li>
                            <% }); %>
                        </ul>
                    </div>
                    <button class="btn btn-blue btn-xl" onclick="addToCart(<%= product.id %>)" style="width:100%; margin-bottom: 12px;">Add to Cart - &pound;<%= product.price.toFixed(2) %></button>
                    <a href="/store" class="btn btn-outline-blue btn-xl" style="width:100%;">&larr; Back to Store</a>
                </div>
            </div>
        </div>
    </section>

    <footer class="footer">
        <div class="container">
            <div class="footer-inner">
                <div class="footer-brand">
                    <h3>SOUTHSIDE <span class="blue-text">RP</span></h3>
                    <p>Premium FiveM Roleplay Server</p>
                </div>
                <div class="footer-links">
                    <a href="/#store">Store</a>
                    <a href="/#about">About</a>
                    <a href="https://discord.gg/pwRPhNWU7T" target="_blank">Discord</a>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2026 <%= storeName %>. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script src="/js/store.js"></script>
    <script>
    window.addEventListener('scroll', function() {
        var navbar = document.getElementById('navbar');
        if (window.scrollY > 50) { navbar.classList.add('scrolled'); }
        else { navbar.classList.remove('scrolled'); }
    });
    </script>
</body>
</html>
